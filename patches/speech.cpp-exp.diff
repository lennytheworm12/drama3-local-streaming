+
+ggml_tensor * ExpertStream::prefetch(ggml_context * c, int next, ggml_tensor * guess, ggml_tensor * slots) {
+    return ggml_map_custom2(c, ggml_cont(c, guess), slots, prefetch_op, 1, data_for(impl_, next));

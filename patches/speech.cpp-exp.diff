 namespace {
 
+/** Experiment switches, read from the environment so the CLI and worker need no new flags. */
+bool env_on(const char * name) {
+    const char * v = std::getenv(name);
+    return v && *v && std::strcmp(v, "0") != 0;
+}
+
+/**
+ * Experiment (SPEECH_MMAP): maps the whole file read-only and returns the mapping, which unmaps when the last owner
+ * lets go, with its size in `size`. On POSIX, SPEECH_MADVISE=random|sequential|willneed advises the kernel.
+ */
+std::shared_ptr<void> map_read_only(const std::string & path, size_t & size) {
+#ifdef _WIN32
+    const int wide_len = MultiByteToWideChar(CP_UTF8, 0, path.c_str(), -1, nullptr, 0);
+    std::wstring wide((size_t) std::max(wide_len, 1), L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, path.c_str(), -1, wide.data(), wide_len);
+    // No FILE_FLAG_RANDOM_ACCESS: it turns off the cache manager's read-ahead, which an expert's contiguous slices
+    // need (on Linux, MADV_RANDOM made streaming 3x slower).
+    HANDLE file = CreateFileW(wide.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) throw Error(Fault::Io, "cannot open " + path + " to map it");
+    LARGE_INTEGER bytes{};
+    if (!GetFileSizeEx(file, &bytes)) {
+        CloseHandle(file);
+        throw Error(Fault::Io, "cannot read the size of " + path);
+    }
+    HANDLE mapping = CreateFileMappingW(file, nullptr, PAGE_READONLY, 0, 0, nullptr);
+    CloseHandle(file);  // the mapping keeps the file open
+    if (!mapping) throw Error(Fault::Io, "cannot map " + path);
+    void * addr = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, 0);
+    CloseHandle(mapping);  // the view keeps the mapping alive
+    if (!addr) throw Error(Fault::Io, "cannot map a view of " + path);
+    size = (size_t) bytes.QuadPart;
+    // Prefetch the whole view (SPEECH_PREFETCH=0 skips it), as llama.cpp does on Windows: one large asynchronous read
+    // into the standby list instead of a page fault per 4 KiB on first use.
+    if (const char * p = std::getenv("SPEECH_PREFETCH"); !p || std::strcmp(p, "0") != 0) {
+        WIN32_MEMORY_RANGE_ENTRY range{addr, size};
+        PrefetchVirtualMemory(GetCurrentProcess(), 1, &range, 0);
+    }
+    return std::shared_ptr<void>(addr, [](void * p) { UnmapViewOfFile(p); });
+#else
+    const int fd = ::open(path.c_str(), O_RDONLY);
+    struct stat st {};
+    if (fd < 0 || fstat(fd, &st) != 0) {
+        if (fd >= 0) ::close(fd);
+        throw Error(Fault::Io, "cannot open " + path + " to map it");
+    }
+    void * addr = mmap(nullptr, (size_t) st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
+    ::close(fd);
+    if (addr == MAP_FAILED) throw Error(Fault::Io, "cannot map " + path);
+    size = (size_t) st.st_size;
+    if (const char * advice = std::getenv("SPEECH_MADVISE")) {
+        const int a = !std::strcmp(advice, "random") ? MADV_RANDOM : !std::strcmp(advice, "sequential") ? MADV_SEQUENTIAL
+                    : !std::strcmp(advice, "willneed") ? MADV_WILLNEED : MADV_NORMAL;
+        madvise(addr, size, a);
+    }
+    const size_t mapped = size;
+    return std::shared_ptr<void>(addr, [mapped](void * p) { munmap(p, mapped); });
+#endif
+}
+
+bool is_cpu(ggml_backend_t backend) {
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    return dev && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU;
+}

+/**
+ * Experiment (SPEECH_PREFETCH_EXPERTS): ask the OS to read routed experts' weights ahead of their use, for weights the
+ * CPU reads from a mapped file (SPEECH_MMAP) that RAM cannot hold. "same": a layer's chosen experts as soon as its router
+ * picks them, all at once, instead of a page fault at a time. "next": also the experts the NEXT layer's router would pick
+ * from this layer's input (pre-gating), a layer ahead.
+ */
+enum class Prefetch { None, Same, Next };
+
+Prefetch prefetch_mode() {
+    static const Prefetch mode = [] {
+        const char * v = std::getenv("SPEECH_PREFETCH_EXPERTS");
+        if (!v) return Prefetch::None;
+        if (!std::strcmp(v, "same")) return Prefetch::Same;
+        if (!std::strcmp(v, "next")) return Prefetch::Next;
+        return Prefetch::None;
+    }();
+    return mode;

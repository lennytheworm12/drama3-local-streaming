+
+void advise_willneed(const char * addr, size_t len) {
+#ifdef _WIN32
+    WIN32_MEMORY_RANGE_ENTRY range{(void *) addr, len};
+    PrefetchVirtualMemory(GetCurrentProcess(), 1, &range, 0);
+#else
+    static const uintptr_t page = (uintptr_t) sysconf(_SC_PAGESIZE);
+    const uintptr_t start = (uintptr_t) addr & ~(page - 1);
+    madvise((void *) start, len + ((uintptr_t) addr - start), MADV_WILLNEED);
+#endif
+}
+
+/** A ggml custom op on the CPU: passes its expert ids through and advises the OS to read those experts' slices. */
+void prefetch_op(ggml_tensor * dst, const ggml_tensor * a, int ith, int, void * userdata) {
+    if (ith != 0) return;
+    std::memcpy(dst->data, a->data, ggml_nbytes(a));
+    const auto * t = (const TextModel::PrefetchTarget *) userdata;
+    const auto * ids = (const int32_t *) a->data;
+    std::vector<bool> seen((size_t) t->experts, false);
+    for (int64_t i = 0; i < ggml_nelements(a); i++) {
+        const int32_t e = ids[i];
+        if (e < 0 || e >= t->experts || seen[(size_t) e]) continue;
+        seen[(size_t) e] = true;
+        for (int k = 0; k < 3; k++) advise_willneed(t->base[k] + (size_t) e * t->stride[k], t->stride[k]);
+    }

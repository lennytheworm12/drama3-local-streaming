+    }
+    Frame f;
+    f.hidden = build_rows(g, e, nullptr);
+    f.logits = mul_mat(c, m_.tensor("output"), f.hidden);
+    g.output(f.logits);
+    return f;
+}
+
+void TextModel::compute_frame(Graph & g) {
+    if (sched_) g.compute(sched_);
+    else g.compute(backend_, allocr_);
+    chosen_log_.clear();
+    n_past_ += 1;

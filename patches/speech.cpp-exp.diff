+    if (x->ne[0] != d_ || (int64_t) frame.size() != 1 + codebooks_) {
+        throw std::invalid_argument("the audio decoder's step takes the state and the frame of one row");
+    }
+    if ((int) uniforms.size() != codebooks_ - 1) throw std::invalid_argument("the fused step takes a uniform for each residual codebook");
+    if (!cache_ || n_past_ + 1 > cache_->capacity()) throw std::invalid_argument("the audio decoder's rows outgrow the sequence it was started for");
+    const std::vector<float> audio = {semantic(main) ? 1.0f : 0.0f};
+    FusedStep s;
+    s.first_code = std::clamp(main - semantic_begin_, 0, vocab_ - 1);
+    const int k = std::min(std::max(top_k, 1), vocab_);
+    const float t = std::max(temperature, 1e-5f);
+
+    ggml_context * c = g.ctx();
+    const Rows r = rows(g, 1, frame.data(), audio, true);
+    ggml_tensor * code_in = g.input(std::vector<int32_t>{s.first_code}, 1);
+    std::vector<float> first_one((size_t) k, 0.0f);
+    first_one[0] = 1.0f;
+    ggml_tensor * first = g.input(first_one, k, 1);      // keeps the top candidate whatever top_p says
+    ggml_tensor * one = g.input(std::vector<float>{1.0f}, 1, 1);
+    ggml_tensor * embedded = nullptr;
+    for (int b = 0; b + 1 < codebooks_; b++) {
+        for (int l = b == 0 ? 0 : shared_ + b; l <= shared_ + b; l++) x = layer(g, l, x, embedded ? nullptr : code_in, r, embedded);
+        ggml_tensor * scaled = ggml_scale(c, mul_mat(c, m_.tensor("ad.head." + std::to_string(b)), x), 1.0f / t);  // [V, 1]
+        ggml_tensor * probs = ggml_soft_max(c, scaled);
+        ggml_tensor * idx = ggml_cont(c, ggml_argsort_top_k(c, scaled, k));                                       // [k, 1], descending
+        ggml_tensor * p = ggml_reshape_2d(c, ggml_get_rows(c, ggml_reshape_2d(c, probs, 1, vocab_), idx), k, 1);
+        ggml_tensor * keep = ggml_clamp(c, ggml_add(c, ggml_step(c, ggml_scale_bias(c, ggml_cumsum(c, p), -1.0f, top_p)), first), 0.0f, 1.0f);
+        ggml_tensor * w = ggml_mul(c, p, keep);
+        ggml_tensor * target = ggml_scale(c, ggml_sum_rows(c, w), (float) uniforms[(size_t) b]);                  // [1, 1]
+        // below[r] = 1 while the cumulative weight is under the target; the pick is the first r where it is not.
+        ggml_tensor * below = ggml_step(c, ggml_sub(c, ggml_repeat(c, target, w), ggml_cumsum(c, w)));
+        ggml_tensor * before = ggml_concat(c, one, ggml_view_2d(c, below, k - 1, 1, below->nb[1], 0), 0);         // below[r-1], 1 at r=0
+        ggml_tensor * onehot = ggml_sub(c, before, below);                                                        // [k, 1]
+        g.output(idx);
+        g.output(onehot);
+        s.idx.push_back(idx);
+        s.pick.push_back(onehot);
+        if (b + 2 < codebooks_) {
+            // The next layer reads the drawn code's embedding: its candidates' rows mixed by the one-hot pick.
+            const std::string next = layer_name(shared_ + b + 1, shared_);
+            ggml_tensor * cand = ggml_get_rows(c, m_.tensor(next + "embd"), idx);                                // [dim, k]
+            embedded = mul_mat(c, ggml_cont(c, ggml_transpose(c, cand)), onehot);                                 // [dim, 1]
+        }
+    }
+    return s;
+}
+
+std::vector<int32_t> AudioDecoder::read_step_fused(const FusedStep & s) {
+    std::vector<int32_t> codes = {s.first_code};
+    for (size_t b = 0; b < s.idx.size(); b++) {
+        std::vector<int32_t> ids((size_t) s.idx[b]->ne[0]);
+        ggml_backend_tensor_get(s.idx[b], ids.data(), 0, ids.size() * sizeof(int32_t));
+        const std::vector<float> oh = Graph::read(s.pick[b]);
+        const size_t at = (size_t) (std::max_element(oh.begin(), oh.end()) - oh.begin());
+        codes.push_back(ids[at]);
+    }
+    n_past_++;
+    return codes;
+}
+
+ggml_tensor * AudioDecoder::drawn_code_embedding(Graph & g, const FusedStep & s) const {
+    // Codebook 1's embeddings are the table's first vocab_size rows, as the text model's own lookup reads them.
+    ggml_context * c = g.ctx();
+    ggml_tensor * cand = ggml_get_rows(c, codebook_embd_, s.idx[0]);                                               // [dim, k]
+    return mul_mat(c, ggml_cont(c, ggml_transpose(c, cand)), s.pick[0]);                                          // [dim, 1]
+}

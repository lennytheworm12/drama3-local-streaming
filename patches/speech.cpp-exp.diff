new file mode 100644
index 0000000..8ec2397
--- /dev/null
+++ b/src/families/drama3/expert-stream.cpp
@@ -0,0 +1,514 @@
+#include "expert-stream.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <numeric>
+#include <stdexcept>
+#include <vector>
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+#include "error.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "gguf.h"
+#include "imatrix.h"
+
+namespace drama3 {
+
+namespace {
+
+constexpr size_t kAlign = 4096;
+
+size_t align_down(size_t v) { return v / kAlign * kAlign; }
+size_t align_up(size_t v) { return (v + kAlign - 1) / kAlign * kAlign; }
+
+double now_ms() {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+/** An aligned buffer for unbuffered reads. */
+struct Aligned {
+    uint8_t * p = nullptr;
+    size_t n = 0;
+    explicit Aligned(size_t bytes) : n(align_up(bytes)) {
+#ifdef _WIN32
+        p = (uint8_t *) VirtualAlloc(nullptr, n, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+#else
+        if (posix_memalign((void **) &p, kAlign, n) != 0) p = nullptr;
+#endif
+        if (!p) throw Error(Fault::OutOfMemory, "cannot allocate a read buffer");
+    }
+    ~Aligned() {
+#ifdef _WIN32
+        VirtualFree(p, 0, MEM_RELEASE);
+#else
+        std::free(p);
+#endif
+    }
+    Aligned(const Aligned &) = delete;
+    Aligned & operator=(const Aligned &) = delete;
+};
+
+/** One read of `len` bytes at file offset `off`, split in order into up to three destinations (an expert's gate, up and
+ * down slots), through an aligned bounce buffer. */
+struct Read {
+    uint64_t off = 0;
+    size_t len = 0;
+    int parts = 0;
+    uint8_t * dst[3] = {nullptr, nullptr, nullptr};
+    size_t part[3] = {0, 0, 0};
+    void scatter(const uint8_t * src) const {
+        for (int k = 0; k < parts; k++) {
+            std::memcpy(dst[k], src, part[k]);
+            src += part[k];
+        }
+    }
+};
+
+}  // namespace
+
+struct ExpertStream::Impl {
+    // the file the experts come from, read without the OS's cache
+#ifdef _WIN32
+    HANDLE file = INVALID_HANDLE_VALUE;
+#else
+    int fd = -1;
+#endif
+    bool overlapped = false, contiguous = false, prefetch = false;
+    int layers = 0, experts = 0;
+    int64_t slots = 0;
+    size_t bytes[3] = {0, 0, 0};             // one expert's gate, up, down
+    std::vector<std::array<uint64_t, 3>> at;  // per layer: file offset of expert 0 of gate, up, down
+    std::vector<uint64_t> whole_at;           // contiguous layout: per layer, offset of expert 0; stride `whole`
+    size_t whole = 0;
+    // the cache
+    std::vector<int32_t> slot_of;            // [layer * experts + expert] -> slot or -1
+    std::vector<int32_t> owner;              // [slot] -> layer * experts + expert or -1
+    std::vector<uint64_t> used;              // [slot] -> tick of last use
+    std::vector<uint8_t> pinned, inflight, fetched;   // [slot]; fetched: read ahead, not yet used
+    uint64_t tick = 0;
+    std::mutex mutex;
+    // pending prefetch reads
+#ifdef _WIN32
+    struct Pending {
+        OVERLAPPED ov{};
+        std::unique_ptr<Aligned> buf;
+        Read r;
+        size_t lead = 0;
+        int32_t slot = -1;
+    };
+    std::vector<std::unique_ptr<Pending>> pending;
+#endif
+    // statistics
+    long long picks = 0, hits = 0, misses = 0, prefetched = 0, prefetch_used = 0, reads = 0;
+    double read_ms = 0, bytes_read = 0;
+    ggml_tensor *gate = nullptr, *up = nullptr, *down = nullptr;
+
+    ~Impl() {
+        std::fprintf(stderr,
+                     "expert-stream: %lld picks, hit rate %.1f%% (%lld misses), %lld reads of %.2f GB in %.1f s (%.0f MB/s while reading)",
+                     picks, picks ? 100.0 * hits / picks : 0.0, misses, reads, bytes_read / 1e9, read_ms / 1e3,
+                     read_ms > 0 ? bytes_read / 1e3 / read_ms : 0.0);
+        if (prefetch) std::fprintf(stderr, ", %lld prefetched, %lld of them used (cache hit rate without them %.1f%%)", prefetched, prefetch_used,
+                                   picks ? 100.0 * (hits - prefetch_used) / picks : 0.0);
+        std::fprintf(stderr, "\n");
+    }
+
+    /** Reads `rs`, all at once where overlapped, else one at a time; blocks until all are in. */
+    void read_all(const std::vector<Read> & rs) {
+        if (rs.empty()) return;
+        const double t0 = now_ms();
+#ifdef _WIN32
+        struct Op {
+            OVERLAPPED ov{};
+            std::unique_ptr<Aligned> buf;
+            size_t lead = 0, span = 0;
+        };
+        std::vector<Op> ops(rs.size());
+        const auto start = [&](size_t i) {
+            const Read & r = rs[i];
+            Op & o = ops[i];
+            const uint64_t a = align_down(r.off);
+            o.lead = (size_t) (r.off - a);
+            o.span = align_up(o.lead + r.len);
+            o.buf = std::make_unique<Aligned>(o.span);
+            o.ov.Offset = (DWORD) (a & 0xffffffffu);
+            o.ov.OffsetHigh = (DWORD) (a >> 32);
+            o.ov.hEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+            if (!ReadFile(file, o.buf->p, (DWORD) o.span, nullptr, &o.ov) && GetLastError() != ERROR_IO_PENDING) {
+                throw Error(Fault::Io, "expert-stream: a read failed to start (" + std::to_string(GetLastError()) + ")");
+            }
+        };
+        const auto finish = [&](size_t i) {
+            Op & o = ops[i];
+            DWORD got = 0;
+            if (!GetOverlappedResult(file, &o.ov, &got, TRUE)) throw Error(Fault::Io, "expert-stream: a read failed");
+            if (got < o.lead + rs[i].len) throw Error(Fault::Io, "expert-stream: a short read");
+            rs[i].scatter(o.buf->p + o.lead);
+            CloseHandle(o.ov.hEvent);
+        };
+        if (overlapped) {
+            for (size_t i = 0; i < rs.size(); i++) start(i);
+            for (size_t i = 0; i < rs.size(); i++) finish(i);
+        } else {
+            for (size_t i = 0; i < rs.size(); i++) {
+                start(i);
+                finish(i);
+            }
+        }
+#else
+        std::vector<uint8_t> tmp;
+        for (const Read & r : rs) {
+            tmp.resize(r.len);
+            if (pread(fd, tmp.data(), r.len, (off_t) r.off) != (ssize_t) r.len) throw Error(Fault::Io, "expert-stream: a short read");
+            r.scatter(tmp.data());
+        }
+#endif
+        read_ms += now_ms() - t0;
+        reads += (long long) rs.size();
+        for (const Read & r : rs) bytes_read += (double) r.len;
+    }
+
+    /** The reads that bring expert `e` of layer `l` into slot `s`: one whole read from the contiguous file, else three. */
+    void reads_for(int l, int e, int32_t s, std::vector<Read> & rs) {
+        uint8_t * d[3] = {(uint8_t *) gate->data + (size_t) s * gate->nb[2], (uint8_t *) up->data + (size_t) s * up->nb[2],
+                          (uint8_t *) down->data + (size_t) s * down->nb[2]};
+        if (contiguous) {
+            Read r;
+            r.off = whole_at[(size_t) l] + (uint64_t) e * whole;
+            r.parts = 3;
+            for (int k = 0; k < 3; k++) {
+                r.dst[k] = d[k];
+                r.part[k] = bytes[k];
+                r.len += bytes[k];
+            }
+            rs.push_back(r);
+            return;
+        }
+        for (int k = 0; k < 3; k++) {
+            Read r;
+            r.off = at[(size_t) l][(size_t) k] + (uint64_t) e * bytes[k];
+            r.len = bytes[k];
+            r.parts = 1;
+            r.dst[0] = d[k];
+            r.part[0] = bytes[k];
+            rs.push_back(r);
+        }
+    }
+
+    /** A free or least recently used unpinned slot, not used since tick `since` and not in flight. */
+    int32_t victim(uint64_t since) {
+        int32_t best = -1;
+        for (int32_t s = 0; s < (int32_t) slots; s++) {
+            // a read-ahead not yet used stays for the layer it was read for
+            if (pinned[(size_t) s] || inflight[(size_t) s] || fetched[(size_t) s]) continue;
+            if (owner[(size_t) s] < 0) return s;
+            if (used[(size_t) s] >= since) continue;
+            if (best < 0 || used[(size_t) s] < used[(size_t) best]) best = s;
+        }
+        if (best < 0) throw Error(Fault::OutOfMemory, "expert-stream: the cache holds fewer experts than a layer's picks; raise SPEECH_STREAM_MB");
+        return best;
+    }
+
+    void assign(int32_t s, int key) {
+        if (owner[(size_t) s] >= 0) slot_of[(size_t) owner[(size_t) s]] = -1;
+        fetched[(size_t) s] = 0;
+        owner[(size_t) s] = key;
+        slot_of[(size_t) key] = s;
+    }
+
+    /**
+     * Lands the prefetches in flight: those into slot `need` (or every one, with -1) waited for, the others only where
+     * already complete, so that a wrong guess still reading costs nothing until its slot is wanted again.
+     */
+    void drain(int32_t need = -2) {
+#ifdef _WIN32
+        for (size_t i = 0; i < pending.size();) {
+            Pending & p = *pending[i];
+            const bool wait = need == -1 || p.slot == need;
+            if (!wait && !HasOverlappedIoCompleted(&p.ov)) {
+                i++;
+                continue;
+            }
+            DWORD got = 0;
+            if (!GetOverlappedResult(file, &p.ov, &got, TRUE)) throw Error(Fault::Io, "expert-stream: a prefetch failed");
+            p.r.scatter(p.buf->p + p.lead);
+            CloseHandle(p.ov.hEvent);
+            const int32_t s = p.slot;
+            pending.erase(pending.begin() + (std::ptrdiff_t) i);
+            bool more = false;
+            for (const auto & q : pending) more = more || q->slot == s;
+            if (!more) inflight[(size_t) s] = 0;
+        }
+#else
+        (void) need;
+#endif
+    }
+
+    void resolve(int l, const int32_t * ids, int64_t n, int32_t * out) {
+        std::lock_guard<std::mutex> lock(mutex);
+        drain();  // only what has landed
+        const uint64_t start = ++tick;
+        std::vector<Read> rs;
+        for (int64_t i = 0; i < n; i++) {
+            const int e = ids[i];
+            const int key = l * experts + e;
+            picks++;
+            int32_t s = slot_of[(size_t) key];
+            if (s >= 0) {
+                hits++;
+                if (inflight[(size_t) s]) {
+                    const double t_wait = now_ms();
+                    drain(s);
+                    read_ms += now_ms() - t_wait;
+                }
+                if (fetched[(size_t) s]) {
+                    fetched[(size_t) s] = 0;
+                    prefetch_used++;
+                }
+            } else {
+                misses++;
+                s = victim(start);
+                assign(s, key);
+                reads_for(l, e, s, rs);
+            }
+            used[(size_t) s] = start;
+            out[i] = s;
+        }
+        read_all(rs);
+        // this layer's read-aheads it did not pick were wrong guesses; their slots are free to take again
+        for (int64_t s = 0; s < slots; s++) {
+            if (fetched[(size_t) s] && owner[(size_t) s] >= 0 && owner[(size_t) s] / experts == l) fetched[(size_t) s] = 0;
+        }
+    }
+
+    void prefetch_layer(int l, const int32_t * ids, int64_t n) {
+#ifdef _WIN32
+        std::lock_guard<std::mutex> lock(mutex);
+        const uint64_t keep_since = tick;  // the slots this layer just resolved stay
+        for (int64_t i = 0; i < n; i++) {
+            const int key = l * experts + ids[i];
+            if (slot_of[(size_t) key] >= 0) continue;
+            while (pending.size() >= 512) drain(pending.front()->slot);  // a bound on reads in flight
+            const int32_t s = victim(keep_since);
+            assign(s, key);
+            used[(size_t) s] = tick;
+            inflight[(size_t) s] = 1;
+            fetched[(size_t) s] = 1;
+            std::vector<Read> rs;
+            reads_for(l, ids[i], s, rs);
+            for (const Read & r : rs) {
+                auto p = std::make_unique<Pending>();
+                const uint64_t a = align_down(r.off);
+                p->lead = (size_t) (r.off - a);
+                const size_t span = align_up(p->lead + r.len);
+                p->buf = std::make_unique<Aligned>(span);
+                p->r = r;
+                p->slot = s;
+                p->ov.Offset = (DWORD) (a & 0xffffffffu);
+                p->ov.OffsetHigh = (DWORD) (a >> 32);
+                p->ov.hEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+                if (!ReadFile(file, p->buf->p, (DWORD) span, nullptr, &p->ov) && GetLastError() != ERROR_IO_PENDING) {
+                    throw Error(Fault::Io, "expert-stream: a prefetch failed to start");
+                }
+                reads++;
+                bytes_read += (double) r.len;
+                pending.push_back(std::move(p));
+            }
+            prefetched++;
+        }
+#else
+        (void) l; (void) ids; (void) n;
+#endif
+    }
+};
+
+namespace {
+
+struct OpData {
+    ExpertStream::Impl * impl;
+    int layer;
+};
+
+void resolve_op(ggml_tensor * dst, const ggml_tensor * a, int ith, int, void * userdata) {
+    if (ith != 0) return;
+    const auto * d = (const OpData *) userdata;
+    d->impl->resolve(d->layer, (const int32_t *) a->data, ggml_nelements(a), (int32_t *) dst->data);
+}
+
+void prefetch_op(ggml_tensor * dst, const ggml_tensor * a, const ggml_tensor *, int ith, int, void * userdata) {
+    if (ith != 0) return;
+    const auto * d = (const OpData *) userdata;
+    std::memcpy(dst->data, a->data, ggml_nbytes(a));
+    // the guess, deduplicated: top-k rows repeat experts across rows
+    std::vector<int32_t> ids((const int32_t *) a->data, (const int32_t *) a->data + ggml_nelements(a));
+    std::sort(ids.begin(), ids.end());
+    ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+    d->impl->prefetch_layer(d->layer, ids.data(), (int64_t) ids.size());
+}
+
+std::vector<std::unique_ptr<OpData>> & op_data() {
+    static std::vector<std::unique_ptr<OpData>> v;
+    return v;
+}
+
+OpData * data_for(ExpertStream::Impl * impl, int layer) {
+    auto & v = op_data();
+    if (v.empty()) {
+        for (int l = 0; l < impl->layers; l++) v.push_back(std::make_unique<OpData>(OpData{impl, l}));
+    }
+    return v[(size_t) layer].get();
+}
+
+}  // namespace
+
+bool ExpertStream::enabled() {
+    const char * v = std::getenv("SPEECH_STREAM_MB");
+    return v && *v && std::atof(v) > 0;
+}
+
+ExpertStream * ExpertStream::get(const ModelFile & m) {
+    static ExpertStream * stream = [&]() -> ExpertStream * {
+        if (!enabled()) return nullptr;
+        auto * s = new ExpertStream;
+        static std::unique_ptr<Impl> owned(new Impl);  // destroyed at exit, which prints the statistics
+        auto * impl = owned.get();
+        s->impl_ = impl;
+        const double budget = std::atof(std::getenv("SPEECH_STREAM_MB")) * 1048576.0;
+        const char * io = std::getenv("SPEECH_STREAM_IO");
+        impl->overlapped = io && std::strcmp(io, "overlapped") == 0;
+        const char * pf = std::getenv("SPEECH_STREAM_PREFETCH");
+        impl->prefetch = pf && *pf == '1';
+        const char * whole_file = std::getenv("SPEECH_STREAM_FILE");
+        impl->contiguous = whole_file && *whole_file;
+
+        ggml_context * meta = nullptr;
+        gguf_init_params ip = {true, &meta};
+        gguf_context * g = gguf_init_from_file(m.path().c_str(), ip);
+        if (!g) throw Error(Fault::Io, "expert-stream: cannot read " + m.path());
+        impl->layers = (int) m.count("drama3.text.num_hidden_layers");
+        const char * names[3] = {"ffn_gate_exps", "ffn_up_exps", "ffn_down_exps"};
+        const ggml_tensor * first[3];
+        for (int k = 0; k < 3; k++) first[k] = ggml_get_tensor(meta, ("blk.0." + std::string(names[k])).c_str());
+        impl->experts = (int) first[0]->ne[2];

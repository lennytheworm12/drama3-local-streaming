--- /dev/null
+++ b/tools/hotx/hotx.cpp
@@ -0,0 +1,169 @@
+// Experiment: writes a sidecar of Drama 3's routed experts split by use. Per layer, the experts the English calibration
+// routed to most (a fraction of them, by the importance matrix's row counts) go to a higher type, the rest to Q4_K, both
+// from the F16 file with the importance matrix weighting the rounding.
+//
+//   hotx F16.gguf imatrix.simx OUT.gguf FRACTION TYPE      (TYPE: q5_K or q6_K)
+//
+// Per layer l, the sidecar holds blk.l.ffn_{gate,up,down}_exps.hot [.., .., hot] in TYPE, blk.l.ffn_{gate,up,down}_exps.cold
+// [.., .., cold] in Q4_K, and blk.l.exps_slot, I32 [experts]: the expert's index among the hot ones, or -1 - its index
+// among the cold ones. The engine reads it with SPEECH_HOT_FILE in place of the main file's routed experts.
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "ggml.h"
+#include "gguf.h"
+#include "imatrix.h"
+
+namespace {
+
+ggml_type type_named(const std::string & name) {
+    for (int k = 0; k < GGML_TYPE_COUNT; k++) {
+        const char * tn = ggml_type_name((ggml_type) k);
+        if (tn && name == tn) return (ggml_type) k;
+    }
+    throw std::runtime_error("no ggml type is named " + name);
+}
+
+/** Quantizes `experts` of the F32 [k, n, all] tensor `values` into `type`, each with its importance weights. */
+std::vector<uint8_t> quantize(const std::vector<float> & values, int64_t k, int64_t n, const std::vector<int> & experts, ggml_type type,
+                              const Imatrix & im, const std::string & name) {
+    const size_t per = ggml_row_size(type, k) * (size_t) n;
+    std::vector<uint8_t> out(per * experts.size());
+    std::vector<std::thread> threads;
+    const int nt = (int) std::max(1u, std::thread::hardware_concurrency());
+    for (int t = 0; t < nt; t++) {
+        threads.emplace_back([&, t] {
+            for (size_t i = (size_t) t; i < experts.size(); i += (size_t) nt) {
+                const std::vector<float> w = im.weights(name, experts[i], k);
+                const float * src = values.data() + (size_t) experts[i] * (size_t) (k * n);
+                ggml_quantize_chunk(type, src, out.data() + i * per, 0, n, k, w.empty() ? nullptr : w.data());
+            }
+        });
+    }
+    for (auto & th : threads) th.join();
+    return out;
+}
+
+}  // namespace
+
+int main(int argc, char ** argv) {
+    if (argc != 6) {
+        std::fprintf(stderr, "usage: hotx F16.gguf imatrix.simx OUT.gguf FRACTION TYPE\n");
+        return 2;
+    }
+    const std::string in = argv[1], out = argv[3];
+    const double fraction = std::atof(argv[4]);
+    const ggml_type hot_type = type_named(argv[5]);
+    ggml_context * meta = nullptr;
+    gguf_init_params ip = {true, &meta};
+    gguf_context * src = gguf_init_from_file(in.c_str(), ip);
+    if (!src) throw std::runtime_error("cannot read " + in);
+    Imatrix im;
+    im.load(argv[2]);
+    const int64_t layers = gguf_get_val_u32(src, gguf_find_key(src, "drama3.text.num_hidden_layers"));
+
+    // The sidecar's tensors, described first so that its header can be written before the data.
+    ggml_init_params cp = {ggml_tensor_overhead() * (size_t) (layers * 7 + 1), nullptr, true};
+    ggml_context * ctx = ggml_init(cp);
+    gguf_context * dst = gguf_init_empty();
+    gguf_set_val_str(dst, "general.architecture", "drama3-hot-experts");
+    gguf_set_val_f32(dst, "hot.fraction", (float) fraction);
+    gguf_set_val_str(dst, "hot.type", ggml_type_name(hot_type));
+    struct Plan {
+        std::string name;
+        int64_t layer;
+        std::vector<int> hot, cold;
+    };
+    std::vector<Plan> plans;
+    for (int64_t l = 0; l < layers; l++) {
+        const std::string p = "blk." + std::to_string(l) + ".";
+        const ggml_tensor * gate = ggml_get_tensor(meta, (p + "ffn_gate_exps").c_str());
+        const int64_t experts = gate->ne[2];
+        // Hot: the most-routed experts by the calibration's row counts.
+        const auto it = im.entries.find(p + "ffn_gate_exps");
+        if (it == im.entries.end()) throw std::runtime_error("the importance matrix has no " + p + "ffn_gate_exps");
+        std::vector<int> order((size_t) experts);
+        std::iota(order.begin(), order.end(), 0);
+        std::stable_sort(order.begin(), order.end(), [&](int a, int b) { return it->second.rows[(size_t) a] > it->second.rows[(size_t) b]; });
+        const int n_hot = (int) std::lround(fraction * (double) experts);
+        Plan plan{p, l, {order.begin(), order.begin() + n_hot}, {order.begin() + n_hot, order.end()}};
+        std::sort(plan.hot.begin(), plan.hot.end());
+        std::sort(plan.cold.begin(), plan.cold.end());
+        for (const char * m : {"ffn_gate_exps", "ffn_up_exps", "ffn_down_exps"}) {
+            const ggml_tensor * full = ggml_get_tensor(meta, (p + m).c_str());
+            for (int part = 0; part < 2; part++) {
+                const int64_t count = part == 0 ? (int64_t) plan.hot.size() : (int64_t) plan.cold.size();
+                ggml_tensor * t = ggml_new_tensor_3d(ctx, part == 0 ? hot_type : GGML_TYPE_Q4_K, full->ne[0], full->ne[1], count);
+                ggml_set_name(t, (p + m + (part == 0 ? ".hot" : ".cold")).c_str());
+                gguf_add_tensor(dst, t);
+            }
+        }
+        ggml_tensor * slot = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, experts);
+        ggml_set_name(slot, (p + "exps_slot").c_str());
+        gguf_add_tensor(dst, slot);
+        plans.push_back(std::move(plan));
+    }
+    FILE * f = std::fopen(out.c_str(), "wb");
+    if (!f) throw std::runtime_error("cannot create " + out);
+    std::vector<uint8_t> header(gguf_get_meta_size(dst));
+    gguf_get_meta_data(dst, header.data());
+    std::fwrite(header.data(), 1, header.size(), f);
+    const size_t align = gguf_get_alignment(dst);
+    size_t written = 0;  // bytes of data so far, against the offsets the header gives
+    const auto put = [&](const std::vector<uint8_t> & bytes, const std::string & name) {
+        const int64_t id = gguf_find_tensor(dst, name.c_str());
+        const size_t at = gguf_get_tensor_offset(dst, id);
+        if (at < written) throw std::logic_error("tensor " + name + " out of order");
+        const std::vector<uint8_t> pad(at - written, 0);
+        std::fwrite(pad.data(), 1, pad.size(), f);
+        if (std::fwrite(bytes.data(), 1, bytes.size(), f) != bytes.size()) throw std::runtime_error("cannot write " + out);
+        written = at + bytes.size();
+    };
+
+    FILE * in_f = std::fopen(in.c_str(), "rb");
+    if (!in_f) throw std::runtime_error("cannot open " + in);
+    const size_t data_at = gguf_get_data_offset(src);
+    std::vector<ggml_fp16_t> halves;
+    std::vector<float> values;
+    for (const Plan & plan : plans) {
+        for (const char * m : {"ffn_gate_exps", "ffn_up_exps", "ffn_down_exps"}) {
+            const std::string name = plan.name + m;
+            const int64_t id = gguf_find_tensor(src, name.c_str());
+            const ggml_tensor * full = ggml_get_tensor(meta, name.c_str());
+            if (full->type != GGML_TYPE_F16) throw std::runtime_error(name + " is not F16");
+            halves.resize((size_t) ggml_nelements(full));
+#ifdef _WIN32
+            _fseeki64(in_f, (long long) (data_at + gguf_get_tensor_offset(src, id)), SEEK_SET);
+#else
+            fseeko(in_f, (off_t) (data_at + gguf_get_tensor_offset(src, id)), SEEK_SET);
+#endif
+            if (std::fread(halves.data(), sizeof(ggml_fp16_t), halves.size(), in_f) != halves.size()) throw std::runtime_error("short read of " + name);
+            values.resize(halves.size());
+            ggml_fp16_to_fp32_row(halves.data(), values.data(), (int64_t) values.size());
+            put(quantize(values, full->ne[0], full->ne[1], plan.hot, hot_type, im, name), name + ".hot");
+            put(quantize(values, full->ne[0], full->ne[1], plan.cold, GGML_TYPE_Q4_K, im, name), name + ".cold");
+        }
+        std::vector<int32_t> slot(plan.hot.size() + plan.cold.size());
+        for (size_t i = 0; i < plan.hot.size(); i++) slot[(size_t) plan.hot[i]] = (int32_t) i;
+        for (size_t i = 0; i < plan.cold.size(); i++) slot[(size_t) plan.cold[i]] = -1 - (int32_t) i;
+        std::vector<uint8_t> bytes(slot.size() * sizeof(int32_t));
+        std::memcpy(bytes.data(), slot.data(), bytes.size());
+        put(bytes, plan.name + "exps_slot");
+        std::fprintf(stderr, "layer %lld: %zu hot, %zu cold\n", (long long) plan.layer, plan.hot.size(), plan.cold.size());
+    }
+    const std::vector<uint8_t> tail(GGML_PAD(written, align) - written, 0);
+    std::fwrite(tail.data(), 1, tail.size(), f);
+    std::fclose(f);
+    std::fclose(in_f);
+    std::fprintf(stderr, "wrote %s\n", out.c_str());
+    return 0;
+}

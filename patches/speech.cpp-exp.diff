diff --git a/src/common/imatrix.cpp b/src/common/imatrix.cpp
new file mode 100755
index 0000000..bf296e9
--- /dev/null
+++ b/src/common/imatrix.cpp
@@ -0,0 +1,193 @@
+#include "imatrix.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+
+#include "ggml-backend.h"
+
+namespace {
+
+constexpr char kMagic[4] = {'S', 'I', 'M', 'X'};
+
+template <typename T>
+bool get(FILE * f, T & v) {
+    return std::fread(&v, sizeof v, 1, f) == 1;
+}
+
+/** The importance matrix this process collects, saved where SPEECH_IMATRIX_OUT names when the process ends. */
+struct Collector {
+    std::mutex mutex;
+    Imatrix matrix;
+    std::string path;
+    std::vector<uint8_t> buffer;
+    int64_t calls = 0;
+
+    Collector() {
+        if (const char * p = std::getenv("SPEECH_IMATRIX_OUT"); p && *p) path = p;
+    }
+    ~Collector() {
+        if (path.empty() || calls == 0) return;
+        try {
+            Imatrix total;
+            total.load(path);
+            for (auto & [name, e] : matrix.entries) {
+                Imatrix::Entry & t = total.entries[name];
+                if (t.rows.empty()) {
+                    t = e;
+                    continue;
+                }
+                if (t.channels != e.channels || t.rows.size() != e.rows.size()) {
+                    std::fprintf(stderr, "imatrix: %s changed shape; keeping the new run only\n", name.c_str());
+                    t = e;
+                    continue;
+                }
+                for (size_t i = 0; i < e.rows.size(); i++) t.rows[i] += e.rows[i];
+                for (size_t i = 0; i < e.sums.size(); i++) t.sums[i] += e.sums[i];
+            }
+            total.save(path);
+            std::fprintf(stderr, "imatrix: %lld products added, %zu matrices in %s\n", (long long) calls, total.entries.size(), path.c_str());
+        } catch (const std::exception & ex) {
+            std::fprintf(stderr, "imatrix: cannot save %s: %s\n", path.c_str(), ex.what());
+        }
+    }
+};
+
+Collector & collector() {
+    static Collector c;
+    return c;
+}
+
+/** The value at row `r1`, plane `r2` of a float32 tensor whose bytes `data` holds, channel `k`. */
+inline float at(const uint8_t * data, const ggml_tensor * t, int64_t k, int64_t r1, int64_t r2, int64_t r3 = 0) {
+    float v;
+    std::memcpy(&v, data + k * t->nb[0] + r1 * t->nb[1] + r2 * t->nb[2] + r3 * t->nb[3], sizeof v);
+    return v;
+}
+
+}  // namespace
+
+void Imatrix::load(const std::string & path) {
+    FILE * f = std::fopen(path.c_str(), "rb");
+    if (!f) return;
+    char magic[4];
+    uint32_t version = 0, n = 0;
+    if (std::fread(magic, 1, 4, f) != 4 || std::memcmp(magic, kMagic, 4) != 0 || !get(f, version) || version != 1 || !get(f, n)) {
+        std::fclose(f);
+        throw std::runtime_error(path + " is not an importance matrix of version 1");
+    }
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t len = 0, mats = 0, channels = 0;
+        if (!get(f, len) || len > 4096) break;
+        std::string name(len, '\0');
+        Entry e;
+        bool ok = std::fread(name.data(), 1, len, f) == len && get(f, mats) && get(f, channels);
+        if (ok) {
+            e.channels = channels;
+            e.rows.resize(mats);
+            std::vector<float> sums((size_t) mats * channels);
+            ok = std::fread(e.rows.data(), sizeof(int64_t), mats, f) == mats && std::fread(sums.data(), sizeof(float), sums.size(), f) == sums.size();
+            e.sums.assign(sums.begin(), sums.end());
+        }
+        if (!ok) {
+            std::fclose(f);
+            throw std::runtime_error(path + " ends inside entry " + std::to_string(i));
+        }
+        Entry & into = entries[name];
+        if (into.rows.empty()) {
+            into = std::move(e);
+        } else if (into.channels == e.channels && into.rows.size() == e.rows.size()) {
+            for (size_t r = 0; r < e.rows.size(); r++) into.rows[r] += e.rows[r];
+            for (size_t s = 0; s < e.sums.size(); s++) into.sums[s] += e.sums[s];
+        }
+    }
+    std::fclose(f);
+}
+
+void Imatrix::save(const std::string & path) const {
+    const std::string tmp = path + ".tmp";
+    FILE * f = std::fopen(tmp.c_str(), "wb");
+    if (!f) throw std::runtime_error("cannot create " + tmp);
+    const uint32_t version = 1, n = (uint32_t) entries.size();
+    bool ok = std::fwrite(kMagic, 1, 4, f) == 4 && std::fwrite(&version, 4, 1, f) == 1 && std::fwrite(&n, 4, 1, f) == 1;
+    for (const auto & [name, e] : entries) {
+        const uint32_t len = (uint32_t) name.size(), mats = (uint32_t) e.rows.size(), channels = (uint32_t) e.channels;
+        const std::vector<float> sums(e.sums.begin(), e.sums.end());
+        ok = ok && std::fwrite(&len, 4, 1, f) == 1 && std::fwrite(name.data(), 1, len, f) == len && std::fwrite(&mats, 4, 1, f) == 1 &&
+             std::fwrite(&channels, 4, 1, f) == 1 && std::fwrite(e.rows.data(), sizeof(int64_t), mats, f) == mats &&
+             std::fwrite(sums.data(), sizeof(float), sums.size(), f) == sums.size();
+    }
+    ok = std::fclose(f) == 0 && ok;
+    if (!ok) throw std::runtime_error("cannot write " + tmp);
+    std::remove(path.c_str());
+    if (std::rename(tmp.c_str(), path.c_str()) != 0) throw std::runtime_error("cannot rename " + tmp + " to " + path);
+}
+
+std::vector<float> Imatrix::weights(const std::string & name, int index, int64_t channels) const {
+    const auto it = entries.find(name);
+    if (it == entries.end() || it->second.channels != channels || index < 0 || index >= (int) it->second.rows.size()) return {};
+    const Entry & e = it->second;
+    const int64_t rows = e.rows[(size_t) index];
+    if (rows <= 0) return {};
+    std::vector<float> w((size_t) channels);
+    for (int64_t k = 0; k < channels; k++) w[(size_t) k] = (float) (e.sums[(size_t) (index * channels + k)] / (double) rows);
+    return w;
+}
+
+bool imatrix_collecting() {
+    return !collector().path.empty();
+}
+
+bool imatrix_collect(ggml_tensor * t, bool ask, void *) {
+    const bool product = t->op == GGML_OP_MUL_MAT || t->op == GGML_OP_MUL_MAT_ID;
+    const ggml_tensor * w = product ? t->src[0] : nullptr;
+    // Only the file's weights: named, and not the intermediate products of attention.
+    const bool weight = w && (std::strncmp(w->name, "blk.", 4) == 0 || std::strncmp(w->name, "ad.", 3) == 0 || std::strcmp(w->name, "output") == 0) && w->op == GGML_OP_NONE;
+    if (ask) return weight;
+    if (!weight) return true;
+    const ggml_tensor * x = t->src[1];
+    if (x->type != GGML_TYPE_F32) return true;
+    Collector & c = collector();
+    std::lock_guard<std::mutex> lock(c.mutex);
+    c.buffer.resize(ggml_nbytes(x));
+    ggml_backend_tensor_get(const_cast<ggml_tensor *>(x), c.buffer.data(), 0, c.buffer.size());
+    const int64_t channels = x->ne[0];
+    const int mats = t->op == GGML_OP_MUL_MAT_ID ? (int) w->ne[2] : 1;
+    Imatrix::Entry & e = c.matrix.entries[w->name];
+    if (e.rows.empty()) {
+        e.channels = channels;
+        e.rows.assign((size_t) mats, 0);
+        e.sums.assign((size_t) mats * channels, 0.0);
+    }
+    if (e.channels != channels || (int) e.rows.size() != mats) return true;
+    if (t->op == GGML_OP_MUL_MAT) {
+        for (int64_t r3 = 0; r3 < x->ne[3]; r3++)
+            for (int64_t r2 = 0; r2 < x->ne[2]; r2++)
+                for (int64_t r1 = 0; r1 < x->ne[1]; r1++) {
+                    for (int64_t k = 0; k < channels; k++) {
+                        const float v = at(c.buffer.data(), x, k, r1, r2, r3);
+                        e.sums[(size_t) k] += (double) v * v;
+                    }
+                    e.rows[0]++;
+                }
+    } else {
+        // ids [used, tokens]; the input of pick j of token i is row j % ne1 of plane i.
+        const ggml_tensor * ids = t->src[2];
+        std::vector<int32_t> id((size_t) ggml_nelements(ids));
+        if (!ggml_is_contiguous(ids)) return true;
+        ggml_backend_tensor_get(const_cast<ggml_tensor *>(ids), id.data(), 0, id.size() * sizeof(int32_t));
+        for (int64_t i = 0; i < ids->ne[1]; i++)
+            for (int64_t j = 0; j < ids->ne[0]; j++) {
+                const int32_t ex = id[(size_t) (i * ids->ne[0] + j)];
+                if (ex < 0 || ex >= mats) continue;
+                for (int64_t k = 0; k < channels; k++) {
+                    const float v = at(c.buffer.data(), x, k, j % x->ne[1], i);
+                    e.sums[(size_t) (ex * channels + k)] += (double) v * v;
+                }
+                e.rows[(size_t) ex]++;
+            }
+    }
+    c.calls++;
+    return true;
+}
diff --git a/src/common/imatrix.h b/src/common/imatrix.h
new file mode 100755
index 0000000..d0c8d12
--- /dev/null
+++ b/src/common/imatrix.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "ggml.h"
+
+/**
+ * Experiment: an importance matrix, the mean square of each input channel a weight matrix multiplies, per matrix (and
+ * per expert of a stacked expert tensor), which ggml's quantizers take to weigh their rounding error.
+ *
+ * File (little-endian): "SIMX", u32 version 1, u32 entries; each entry: u32 name bytes, name, u32 matrices, u32 channels,
+ * then matrices i64 row counts, then matrices x channels f32 sums of squares. Sums, not means, so that runs add up.
+ */
+struct Imatrix {
+    struct Entry {
+        int64_t channels = 0;
+        std::vector<int64_t> rows;  // per matrix
+        std::vector<double> sums;   // [matrices][channels]
+    };
+    std::map<std::string, Entry> entries;
+
+    /** Adds the file at `path` to this one; a missing file adds nothing. Throws on a malformed file. */
+    void load(const std::string & path);
+    void save(const std::string & path) const;
+
+    /**
+     * The weights for matrix `index` of the tensor `name`, `channels` of them: the mean square of each channel, or empty
+     * where the tensor has no entry or that matrix saw no row.
+     */
+    std::vector<float> weights(const std::string & name, int index, int64_t channels) const;
+};
+
+/**
+ * Experiment (SPEECH_IMATRIX_OUT=path): a scheduler eval callback that accumulates every MUL_MAT and MUL_MAT_ID of a
+ * named weight into the importance matrix of the process, which is saved to `path` (adding to what it held) at exit.
+ */
+bool imatrix_collect(ggml_tensor * t, bool ask, void * user_data);
+/** Whether SPEECH_IMATRIX_OUT is set. */
+bool imatrix_collecting();

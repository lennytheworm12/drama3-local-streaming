+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "ggml.h"
+#include "model-file.h"
+
+namespace drama3 {
+
+/**
+ * Experiment (SPEECH_STREAM_MB=budget): routed experts of the CPU's layers read from the SSD into a cache of whole
+ * experts instead of held in RAM. The cache is three stacked tensors (gate, up, down) of `slots` experts; a layer's picks
+ * become slot indices, which ggml's mul_mat_id reads like expert indices, so the arithmetic and the takes are those of
+ * the experts held in RAM. Switches:
+ * - SPEECH_STREAM_PIN=f: the fraction of slots pinned, at start, to the experts the calibration routed to most
+ *   (SPEECH_STREAM_IMATRIX's row counts); the rest are least recently used.
+ * - SPEECH_STREAM_IO=sync|overlapped: misses read one after another, or all of a layer's at once (Windows overlapped,
+ *   unbuffered reads, which bypass the OS's file cache either way).
+ * - SPEECH_STREAM_FILE=path: a file of the experts laid out whole (gate, up, down back to back, 4 KiB aligned), one
+ *   read per expert instead of three; written by scorecard/tools/stream_layout.py.
+ * - SPEECH_STREAM_PREFETCH=1: the next layer's router applied to this layer's input guesses its picks, read ahead.
+ * Statistics print at exit.
+ */
+class ExpertStream {
+public:
+    /** The stream of the process for model file `m`, made on first use; null without SPEECH_STREAM_MB. */
+    static ExpertStream * get(const ModelFile & m);
+    /** Whether streaming is on (SPEECH_STREAM_MB set). */
+    static bool enabled();
+
+    ggml_tensor * gate() const { return gate_; }
+    ggml_tensor * up() const { return up_; }
+    ggml_tensor * down() const { return down_; }
+
+    /**
+     * The graph's node that turns layer `layer`'s picks `chosen`, I32 [used, rows], into cache slots, reading the missing
+     * experts; and, with prefetch, the node that reads ahead the picks `guess` of layer `next` once `slots` are resolved.
+     */
+    ggml_tensor * resolve(ggml_context * c, int layer, ggml_tensor * chosen);
+    ggml_tensor * prefetch(ggml_context * c, int next, ggml_tensor * guess, ggml_tensor * slots);
+
+    struct Impl;
+
+private:
+    ExpertStream() = default;
+    ggml_tensor *gate_ = nullptr, *up_ = nullptr, *down_ = nullptr;
+    Impl * impl_ = nullptr;
+};
+
+}  // namespace drama3

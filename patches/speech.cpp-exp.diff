+        const char * src = (const char *) table->data + (size_t) main * table->nb[1];
+        if (table->type == GGML_TYPE_F32) std::memcpy(row.data(), src, (size_t) h_ * sizeof(float));
+        else ggml_get_type_traits(table->type)->to_float(src, row.data(), h_);
+        e = g.input(row, h_, 1);
+    } else {
+        e = ggml_get_rows(c, table, g.input(std::vector<int32_t>{main}, 1));
+    }
+    // The same nodes as build_embed() for a frame, the drawn code's row in place of its lookup.
+    if (seen_ > 0) {
+        if (seen_ != 1) throw std::invalid_argument("a frame's graph mixes in one code the text model sees");
+        const float audio = main >= semantic_begin_ && main <= semantic_end_ ? 1.0f : 0.0f;
+        ggml_tensor * mixed = ggml_scale(c, ggml_add(c, e, code_embedding), 1.0f / std::sqrt((float) (1 + seen_)));
+        e = ggml_add(c, ggml_mul(c, e, g.input(std::vector<float>{1.0f - audio}, 1, 1)), ggml_mul(c, mixed, g.input(std::vector<float>{audio}, 1, 1)));
+    }
+    Frame f;
+    f.hidden = build_rows(g, e, nullptr);
+    f.logits = mul_mat(c, m_.tensor("output"), f.hidden);
+    g.output(f.logits);
+    return f;
+}
+
+void TextModel::compute_frame(Graph & g) {
+    if (sched_) g.compute(sched_);
+    else g.compute(backend_, allocr_);
+    chosen_log_.clear();
+    n_past_ += 1;
+}
+
 std::vector<float> TextModel::delta_state(int l) const {
     return Graph::read(states_->delta[(size_t) slot_[(size_t) l]]);
 }

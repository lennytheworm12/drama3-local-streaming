diff --git a/src/ggml-backend.cpp b/src/ggml-backend.cpp
index ffbcba36..e6adf244 100644
--- a/src/ggml-backend.cpp
+++ b/src/ggml-backend.cpp
@@ -20,7 +20,9 @@
 #include <stdlib.h>
 #include <string.h>
 #include <algorithm>
+#include <chrono>
 #include <unordered_map>
+#include <unordered_set>
 #include <vector>
 
 #ifdef __APPLE__
@@ -1862,16 +1864,51 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
     }
 }
 
+// speech.cpp experiment (GGML_SCHED_TIMING=1): where a scheduled graph's time goes, per backend: copying a split's
+// inputs, and its compute (synchronized after each split, so the attribution is exact but overlap is lost).
+// Prints totals every 500 graphs to stderr.
+struct sched_timing {
+    bool on = getenv("GGML_SCHED_TIMING") != nullptr;
+    double copy_ms[GGML_SCHED_MAX_BACKENDS] = {0}, compute_ms[GGML_SCHED_MAX_BACKENDS] = {0};
+    long splits[GGML_SCHED_MAX_BACKENDS] = {0};
+    long graphs = 0;
+};
+static sched_timing g_sched_timing;
+static double sched_now_ms() {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
 static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t sched) {
     GGML_ASSERT(sched);
     struct ggml_backend_sched_split * splits = sched->splits;
 
     int prev_backend_id = -1;
+    sched_timing & tm = g_sched_timing;
+    // speech.cpp experiment (GGML_SCHED_SPLITS=n): the splits of the first n graphs, backend initial and nodes of each.
+    static const long show_splits = getenv("GGML_SCHED_SPLITS") ? atol(getenv("GGML_SCHED_SPLITS")) : 0;
+    static long shown = 0;
+    if (shown < show_splits) {
+        shown++;
+        fprintf(stderr, "sched-splits: graph %ld, %d splits:", shown, sched->n_splits);
+        for (int i = 0; i < sched->n_splits; i++) {
+            fprintf(stderr, " %c%d/%d", ggml_backend_name(sched->backends[splits[i].backend_id])[0], splits[i].i_end - splits[i].i_start, splits[i].n_inputs);
+        }
+        fprintf(stderr, "\n");
+    }
+
+    // speech.cpp experiment (GGML_SCHED_EARLY=1): where a device split is followed by a CPU split, the device split's
+    // nodes after the last one the CPU split reads (Drama 3's shared expert, built after the router) are held back
+    // and submitted once the CPU split has copied its inputs, so the device computes them while the CPU computes.
+    // The device runs its nodes in the graph's order either way, so the allocator's reuse of memory still holds.
+    static const bool early = getenv("GGML_SCHED_EARLY") != nullptr;
+    struct ggml_cgraph tail = {};
+    int tail_backend = -1;
 
     for (int split_id = 0; split_id < sched->n_splits; split_id++) {
         struct ggml_backend_sched_split * split = &splits[split_id];
         int split_backend_id = split->backend_id;
         ggml_backend_t split_backend = sched->backends[split_backend_id];
+        const double t_start = tm.on ? sched_now_ms() : 0;
 
         // ensure the previous split's async work has completed before we start
         // this split, the allocator may have reused buffer regions across splits
@@ -1896,11 +1933,52 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             }
         }
 
-        if (!sched->callback_eval) {
+        if (tail_backend >= 0) {
+            // the CPU split's inputs are copied: the device goes on with the nodes held back
+            enum ggml_status ec = ggml_backend_graph_compute_async(sched->backends[tail_backend], &tail);
+            if (ec != GGML_STATUS_SUCCESS) return ec;
+            tail_backend = -1;
+        }
+
+        int head_nodes = split->graph.n_nodes;
+        if (early && !sched->callback_eval && split_id + 1 < sched->n_splits &&
+            ggml_backend_dev_type(ggml_backend_get_device(sched->backends[splits[split_id + 1].backend_id])) == GGML_BACKEND_DEVICE_TYPE_CPU &&
+            ggml_backend_dev_type(ggml_backend_get_device(split_backend)) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            const struct ggml_backend_sched_split * next = &splits[split_id + 1];
+            std::unordered_map<const ggml_tensor *, int> index;
+            for (int j = 0; j < split->graph.n_nodes; j++) index[split->graph.nodes[j]] = j;
+            int last = -1;
+            for (int k = 0; k < next->n_inputs; k++) {
+                for (const ggml_tensor * t = next->inputs[k]; t; t = t->view_src) {
+                    auto it = index.find(t);
+                    if (it != index.end() && it->second > last) last = it->second;
+                }
+            }
+            if (last + 1 < split->graph.n_nodes) {
+                head_nodes = last + 1;
+                tail = ggml_graph_view(&split->graph, head_nodes, split->graph.n_nodes);
+                tail_backend = split_backend_id;
+                static long told = 0;
+                if (told++ < 3) fprintf(stderr, "sched-early: split %d of %d nodes holds back %d\n", split_id, split->graph.n_nodes, split->graph.n_nodes - head_nodes);
+            }
+        }
+
+        if (!sched->callback_eval && head_nodes < split->graph.n_nodes) {
+            struct ggml_cgraph head = ggml_graph_view(&split->graph, 0, head_nodes);
+            enum ggml_status ec = ggml_backend_graph_compute_async(split_backend, &head);
+            if (ec != GGML_STATUS_SUCCESS) return ec;
+        } else if (!sched->callback_eval) {
+            const double t_copied = tm.on ? sched_now_ms() : 0;
             enum ggml_status ec = ggml_backend_graph_compute_async(split_backend, &split->graph);
             if (ec != GGML_STATUS_SUCCESS) {
                 return ec;
             }
+            if (tm.on) {
+                ggml_backend_synchronize(split_backend);
+                tm.copy_ms[split_backend_id] += t_copied - t_start;
+                tm.compute_ms[split_backend_id] += sched_now_ms() - t_copied;
+                tm.splits[split_backend_id]++;
+            }
         } else {
             // similar to ggml_backend_compare_graph_backend
             for (int j0 = 0; j0 < split->graph.n_nodes; j0++) {
@@ -1943,6 +2021,14 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         prev_backend_id = split_backend_id;
     }
 
+    if (tm.on && ++tm.graphs % 500 == 0) {
+        for (int b = 0; b < sched->n_backends; b++) {
+            fprintf(stderr, "sched-timing: %ld graphs, %s: %ld splits (%.1f per graph), copy %.3f ms/graph, compute %.3f ms/graph, per split copy %.3f compute %.3f ms\n",
+                    tm.graphs, ggml_backend_name(sched->backends[b]), tm.splits[b], (double) tm.splits[b] / tm.graphs,
+                    tm.copy_ms[b] / tm.graphs, tm.compute_ms[b] / tm.graphs,
+                    tm.splits[b] ? tm.copy_ms[b] / tm.splits[b] : 0.0, tm.splits[b] ? tm.compute_ms[b] / tm.splits[b] : 0.0);
+        }
+    }
     return GGML_STATUS_SUCCESS;
 }
 
diff --git a/src/ggml-cpu/ggml-cpu.c b/src/ggml-cpu/ggml-cpu.c
